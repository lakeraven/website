---
layout: layouts/page
pagination:
  data: aianScorecard.states
  size: 1
  alias: s
permalink: "/aian-medicaid-scorecard/{{ s.slug }}/"
eleventyComputed:
  title: "{{ s.name }}: AI/AN Medicaid exemption scorecard"
---
{% set sc = aianScorecard %}
{% set sub = sc.rubric.submission %}
{% if not sc.rubric.approved %}
<div class="usa-alert usa-alert--warning usa-alert--slim"><div class="usa-alert__body"><p class="usa-alert__text"><strong>Draft.</strong> This grade is provisional while the rubric is under review and evidence is re-verified.</p></div></div>
{% endif %}

<p><a href="{{ '/aian-medicaid-scorecard/' | url }}">All states</a></p>
<h1>{{ s.name }}</h1>

{% if s.under_review %}
<div class="usa-alert usa-alert--info usa-alert--slim"><div class="usa-alert__body"><p class="usa-alert__text"><strong>Evidence under review.</strong> Someone has submitted new evidence for {{ s.name }}. The grade below stands until review is complete.</p></div></div>
{% endif %}

{% if s.status == 'not_subject' %}
<p class="font-sans-lg"><strong>Not subject.</strong> {{ s.name }} has not expanded Medicaid, so the expansion-group work requirement and six-month renewals do not apply.{% if not s.confirmed %} (Status to be confirmed from a primary source.){% endif %}</p>
{% else %}
<p class="font-sans-lg">Grade: <strong>{{ s.grade }}</strong>. Meets {{ s.met }} of 9 requirements, contradicts {{ s.contradicts }}, and has not published policy on {{ s.unpublished }}.</p>
<p>Evidence last checked {{ s.checked }}.{% if s.start %} Work requirement start date: {{ s.start }}.{% endif %}</p>

<h2>Requirements</h2>
<table class="usa-table usa-table--borderless usa-table--stacked">
  <thead><tr><th scope="col">Requirement</th><th scope="col" class="aian-finding">Finding</th><th scope="col">What the state published</th></tr></thead>
  <tbody>
  {% for r in s.requirements %}
    <tr>
      <th scope="row" data-label="Requirement">{{ r.label }}<br><span class="text-base">{{ r.citation }}</span></th>
      <td data-label="Finding" class="aian-finding">{% if r.mark == 'meets' %}Meets{% elif r.mark == 'contradicts' %}Contradicts{% else %}Not published{% endif %}</td>
      <td data-label="What the state published">{% if r.url %}&ldquo;{{ r.quote }}&rdquo; <a href="{{ r.url }}">Source</a>{% if r.read %}, read {{ r.read }}{% endif %}{% else %}Nothing found.{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Also reported (not graded)</h2>
<ul class="usa-list">
{% for b in s.bestPractices %}<li>{{ b.label }}: {% if b.mark == 'meets' %}yes{% elif b.mark == 'contradicts' %}no{% else %}nothing published{% endif %}{% if b.url %} (<a href="{{ b.url }}">source</a>){% endif %}</li>{% endfor %}
</ul>
{% endif %}

<h2>History</h2>
{% if s.history and s.history.length %}
<ul class="usa-list">
{% for h in s.history %}<li>{{ h.date }}: {{ h.from }} to {{ h.to }}. {{ h.change }} <a href="{{ h.url }}">Source</a></li>{% endfor %}
</ul>
{% else %}
<p>No grade changes since first published.</p>
{% endif %}

<h2 id="submit">Submit evidence</h2>
<p>If {{ s.name }} has published policy that changes any finding above, send us a public link to it. Please send links rather than attachments. We review every submission within {{ sub.review_business_days }} business days, and we weigh evidence from tribes and Indian health programs the same as evidence from the state. <a href="{{ '/aian-medicaid-scorecard/process/' | url }}">How review works</a>.</p>
{% if sub.form_url %}
<p><a class="usa-button" href="{{ sub.form_url }}{{ s.state }}">Submit evidence for {{ s.name }}</a></p>
{% else %}
<p><a class="usa-button" href="mailto:{{ sub.email }}?subject={{ ('Scorecard evidence: ' + s.name) | urlencode }}&body={{ 'Link to the published policy:%0D%0AWhich requirement it addresses:%0D%0AYour organization (state agency, tribe, Indian health program, other):%0D%0A' }}">Email evidence for {{ s.name }}</a></p>
{% endif %}
